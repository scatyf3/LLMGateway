# Copy to .env. Everything is optional: with no keys the gateway serves from the mock backends.

# Real providers (a backend with an empty key is skipped by the router)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Self-hosted vLLM: `docker compose --profile gpu up`, or a cluster job (deploy/vllm-slurm.sh)
VLLM_ENABLED=false
VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_BASE_URL=http://host.docker.internal:8000/v1   # vLLM reached through an SSH tunnel
HUGGING_FACE_HUB_TOKEN=

# Gateway client keys referenced by config/gateway.yaml (secret_env). The demo key sk-gw-demo is built in.
GATEWAY_KEY_DOCPILOT=sk-gw-docpilot-change-me
GATEWAY_KEY_FREE=sk-gw-free-change-me

# Prompts with at least this many (estimated) tokens on `fast`/`cheap` go to the `local` chain
GATEWAY_LONG_PROMPT_TOKENS=3000

# Running outside Docker: in-process Redis, no server needed
# GATEWAY_REDIS_URL=fakeredis://
GATEWAY_LOG_LEVEL=INFO
